SIEM_LOG_LEVEL=INFO
SIEM_DB_PATH=data/events.db
SIEM_DASHBOARD_PORT=8080
SIEM_DASHBOARD_HOST=0.0.0.0

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_password
ALERT_EMAIL_TO=security@company.com

# Webhook (Slack/Teams)
WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Syslog listener
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

# Log files to monitor (comma-separated)
WATCH_LOG_FILES=/var/log/auth.log,/var/log/syslog,/var/log/apache2/access.log
